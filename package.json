{
  "name": "@local/dsh-token-meter",
  "version": "1.1.0",
  "description": "Whole-profile DSH token ledger: cost with peak/off-peak split, token composition, cache hit rate, daily trend, weekday-hour rhythm, cost rankings, and a searchable, sortable, paged request ledger with CSV export.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "token",
    "usage",
    "cost",
    "dashboard"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
